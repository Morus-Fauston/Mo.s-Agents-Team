{
  "name": "@mos/agents-team",
  "description": "Project initialization and local console for Mo's Agents Team.",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.21.0"
  },
  "packageManager": "pnpm@11.28.5",
  "exports": {
    ".": "./dist/宿主/插件.js",
    "./locale/*.json": "./资源/语言/*.json",
    "./icon": "./资源/图标.svg"
  },
  "bin": {
    "mat": "./dist/命令/入口.js"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "pnpm-workspace.yaml",
    "资源"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "vitest run",
    "lint": "eslint 源码 界面 测试 脚本 *.config.ts",
    "format:check": "prettier --check package.json pnpm-workspace.yaml tsconfig.*.json *.config.ts eslint.config.js .prettierrc.json cordis.patch.yml 源码 界面 测试 脚本 资源",
    "typecheck:node": "tsc -p tsconfig.node.json --noEmit",
    "typecheck:web": "tsc -p tsconfig.web.json --noEmit",
    "build:node": "tsc -p tsconfig.node.json",
    "build:web": "vite build",
    "build": "pnpm run build:node && pnpm run build:web",
    "package": "node 脚本/打包.mjs",
    "mat": "node dist/命令/入口.js"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1",
    "@tanstack/react-query": "5.106.1",
    "radix-ui": "1.8.1",
    "hono": "4.13.16",
    "@hono/node-server": "2.1.6",
    "zod": "4.6.7",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "rehype-highlight": "7.0.2"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "vite": "8.3.6",
    "@vitejs/plugin-react": "6.2.1",
    "vitest": "5.1.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.14.0",
    "@eslint/js": "10.0.1",
    "typescript-eslint": "8.72.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.9.10",
    "@testing-library/react": "16.3.3",
    "@testing-library/dom": "10.4.2",
    "@playwright/test": "1.64.1"
  }
}
